        {
          "info": {
            "name": "Retrieve Attributes Embedded Data Mapping Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mediavalet.com/attributes/embeddedDataMappingType",
            "headers": [
