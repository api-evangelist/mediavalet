                "value": "1.0"
              }
            ]
          },
          "docs": "Returns an of embedded attribute data mapping types."
        },
        {
          "info": {
            "name": "Retrieve Attributes Embedded Data Values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mediavalet.com/attributes/:dataTypeValue/embeddedDataValue",
            "headers": [
              {
                "name": "x-mv-api-version",
                "value": "1.0"
              }
            ],
            "params": [
              {
                "name": "dataTypeValue",
                "value": "",
                "type": "path",
                "description": "dataTypeValue path parameter."
              }
            ]
          },
          "docs": "Returns an embedded attribute data values."
