{
  "opencollection": "1.0.0",
  "info": {
    "name": "MediaValet Home API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.mediavalet.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Home",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Json Home Document",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mediavalet.com/",
            "headers": [
              {
                "name": "x-mv-api-version",
                "value": "1.2"
              }
            ]
          },
          "docs": "Retrieve a collection of endpoints that are available to authenticated user."
        },
        {
          "info": {
            "name": "Home Bulk",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mediavalet.com/bulk"
          },
          "docs": "Home Bulk"
        }
      ]
    }
  ],
  "bundled": true
}