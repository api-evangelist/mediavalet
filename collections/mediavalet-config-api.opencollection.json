{
  "opencollection": "1.0.0",
  "info": {
    "name": "MediaValet Config API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.mediavalet.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Config",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Cognitive Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mediavalet.com/config/cognitive",
            "headers": [
              {
                "name": "x-mv-api-version",
                "value": "1.2"
              }
            ]
          },
          "docs": "Retrieves the configuration for Cognitive Tags."
        },
        {
          "info": {
            "name": "Retrieve Rendition Kinds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mediavalet.com/config/renditionkinds",
            "headers": [
              {
                "name": "x-mv-api-version",
                "value": "1.2"
              }
            ]
          },
          "docs": "Retrieves the supported rendition kinds."
        }
      ]
    }
  ],
  "bundled": true
}