            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mediavalet.com/directlinks/export",
            "headers": [
              {
                "name": "x-mv-api-version",
                "value": "1.2"
              }
            ]
          },
          "docs": "Returns a zip file of collection of direct links."
