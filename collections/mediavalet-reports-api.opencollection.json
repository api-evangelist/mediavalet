{
  "opencollection": "1.0.0",
  "info": {
    "name": "MediaValet Reports API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.mediavalet.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Report Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mediavalet.com/reports",
            "headers": [
              {
                "name": "x-mv-api-version",
                "value": "1.2"
              }
            ]
          },
          "docs": "Returns a collection of report types."
        },
        {
          "info": {
            "name": "Retrieve Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mediavalet.com/report/:reportType",
            "headers": [
              {
                "name": "x-mv-api-version",
                "value": "1.2"
              }
            ],
            "params": [
              {
                "name": "reportType",
                "value": "",
                "type": "path",
                "description": "reportType path parameter."
              }
            ]
          },
          "docs": "Returns a report."
        },
        {
          "info": {
            "name": "Retrieve Reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mediavalet.com/reports/:reportType",
            "headers": [
              {
                "name": "x-mv-api-version",
                "value": "1.2"
              }
            ],
            "params": [
              {
                "name": "reportType",
                "value": "",
                "type": "path",
                "description": "reportType path parameter."
              }
            ]
          },
          "docs": "Returns reports by report type."
        },
        {
          "info": {
            "name": "Retrieve Users Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
